# ─── LLM Provider Configuration ───────────────────────────────────────────────
# Which provider to use by default: local, openai, anthropic, gemini, grok
LLM_PROVIDER=local
# Override the default model for the chosen provider (optional)
LLM_MODEL=

# ─── Local LLM (Ollama) ──────────────────────────────────────────────────────
# Ollama exposes an OpenAI-compatible API at /v1
OLLAMA_HOST=http://localhost:11434

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── xAI (Grok) ──────────────────────────────────────────────────────────────
XAI_API_KEY=
